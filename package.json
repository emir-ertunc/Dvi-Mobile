{
  "name": "dvi-mobile",
  "version": "0.5.7",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "forensics:inspect": "node scripts/run-python.js scripts/inspect_fillable_pdfs.py",
    "forensics:verify": "node scripts/run-python.js scripts/inspect_fillable_pdfs.py --verify-generated",
    "pdf:prompts": "node scripts/run-python.js scripts/build_pdf_field_prompts.py --write",
    "pdf:prompts:verify": "node scripts/run-python.js scripts/build_pdf_field_prompts.py",
    "inventory:am": "node scripts/build_am_inventory.js --write",
    "inventory:am:verify": "node scripts/build_am_inventory.js",
    "inventory:pm": "node scripts/build_pm_inventory.js --write",
    "inventory:pm:verify": "node scripts/build_pm_inventory.js",
    "inventory:audit": "node scripts/audit_form_inventories.js --write",
    "inventory:audit:verify": "node scripts/audit_form_inventories.js",
    "schema:primitives": "node scripts/verify_field_primitives.js --write",
    "schema:primitives:verify": "node scripts/verify_field_primitives.js",
    "schema:am": "node scripts/build_am_schema.js --write",
    "schema:am:verify": "node scripts/build_am_schema.js",
    "schema:pm": "node scripts/build_pm_schema.js --write",
    "schema:pm:verify": "node scripts/build_pm_schema.js",
    "schema:coverage": "node scripts/audit_schema_coverage.js --write",
    "schema:coverage:verify": "node scripts/audit_schema_coverage.js",
    "drafts:storage:verify": "node scripts/verify_draft_storage_contract.js",
    "forms:renderer:verify": "node scripts/verify_form_renderer.js",
    "forms:input:verify": "node scripts/verify_form_input_contract.js",
    "forms:visible:verify": "node scripts/verify_visible_form_entry_contract.js",
    "ui:labels": "node scripts/build_ui_labels.js --write",
    "ui:labels:verify": "node scripts/build_ui_labels.js",
    "ui:coverage": "node scripts/audit_ui_coverage.js --write",
    "ui:coverage:verify": "node scripts/audit_ui_coverage.js",
    "field:contract": "node scripts/audit_field_contract.js --write",
    "field:contract:verify": "node scripts/audit_field_contract.js",
    "pdf:templates": "node scripts/build_pdf_template_manifest.js --write",
    "pdf:templates:verify": "node scripts/build_pdf_template_manifest.js",
    "rebaseline:verify": "node scripts/verify_rebaseline.js",
    "text:verify-tr": "node scripts/verify_ui_text_tr.js",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "~2.2.0",
    "expo": "~54.0.33",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  }
}
